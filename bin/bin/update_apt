#!/bin/bash
set -euxo pipefail

# Run sudo commands first to get the password prompt out of the way
if [ -f "$(which apt-get)" ]; then
  sudo apt -y update && apt list --upgradable && sudo apt -y dist-upgrade
  sudo apt autoremove
fi

deactivate &> /dev/null || true
# Commented out until https://github.com/pnpm/pnpm/issues/11798 is fixed
# pnpm --global update -L
rustup update stable
cargo install-update --all --cooldown 7d

WEEKAGO=
# MacOS use date -v-7d, Linux use date -I -d "7 days ago"
if [ $(uname -s) = "Darwin" ]; then
  WEEKAGO=$(date -I -v-7d)
else
  WEEKAGO=$(date -I -d "7 days ago")
fi

if [ -f "$(which pipx)" ]; then
  pipx upgrade-all
fi

if [ -f "$(which uv)" ]; then
  uv tool update --all --exclude-newer ${WEEKAGO}
fi

if [ -f "$(which brew)" ]; then
  # Sometimes brew returns a failure exit code when nothing actually failed
  brew upgrade || true
fi

if [ -f "$(which devin)" ]; then
  devin update
fi


nvim "+lua require('lazy').sync()"
